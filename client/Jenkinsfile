pipeline {
    agent any

    stages {

        stage('Frontend Info') {
            steps {
                dir('client') {
                    bat 'node --version'
                    bat 'npm --version'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('client') {
                    bat 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('client') {
                    bat 'npm run lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('client') {
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Info') {
            steps {
                bat 'docker version'
            }
        }

        stage('Docker Build') {
            steps {
                dir('client') {
                    bat 'docker build -t coreinventory-frontend:jenkins .'
                }
            }
        }

        stage('Docker Deploy') {
            steps {
                bat 'docker stop coreinventory-frontend-jenkins || exit /b 0'
                bat 'docker rm coreinventory-frontend-jenkins || exit /b 0'
                bat 'docker run -d --name coreinventory-frontend-jenkins -p 8082:80 coreinventory-frontend:jenkins'
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully!'
        }

        failure {
            echo 'Frontend pipeline failed.'
        }
    }
}